@startuml
left to right direction
skinparam packageStyle rectangle

actor "Procurement Officer" as PO
actor "Warehouse Operator" as WO
actor "Inventory Analyst" as IA
actor "Logistics Manager" as LM
actor "System Administrator" as Admin

rectangle "Supply Chain & Inventory Management Platform" {
  
  package "Supplier Management" {
    usecase "Register Supplier" as UC1
    usecase "Evaluate Supplier Performance" as UC2
  }
  
  package "Procurement" {
    usecase "Create Purchase Request" as UC3
    usecase "Approve Purchase Order" as UC4
  }
  
  package "Inventory Management" {
    usecase "View Inventory Levels" as UC5
    usecase "Perform Cycle Count" as UC6
    usecase "Adjust Inventory" as UC7
  }
  
  package "Shipment Management" {
    usecase "Create Shipment" as UC8
    usecase "Track Delivery" as UC9
  }
  
  package "Reporting" {
    usecase "View KPI Dashboards" as UC10
  }
}

PO --> UC1
PO --> UC2
PO --> UC3
PO --> UC4
PO --> UC5

WO --> UC6
WO --> UC7
WO --> UC5

IA --> UC5
IA --> UC7
IA --> UC10

LM --> UC8
LM --> UC9
LM --> UC10
LM --> UC2

Admin --> UC1
Admin --> UC10

@enduml
